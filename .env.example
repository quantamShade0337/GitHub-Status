# ── GitPersona environment ───────────────────────────────────────────────────
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Every variable here is OPTIONAL except where noted — the app runs with none of
# them set (live scans only, in-memory cache, no persistence).

# ── Database (OPTIONAL) ───────────────────────────────────────────────────────
# Persistence is optional. With no DATABASE_URL the app works fully — scans run
# live and the cache handles speed; a DB only persists scan summaries across
# restarts (powers "recently scanned" + instant repeats).
#
# Local dev uses SQLite:
DATABASE_URL="file:./dev.db"
#
# On Railway with a volume mounted at /data:
#   DATABASE_URL="file:/data/gitpersona.db"
#
# To explicitly run with NO persistence even if DATABASE_URL is set:
#   PERSISTENCE_DISABLED="1"

# ── GitHub token (OPTIONAL, recommended) ──────────────────────────────────────
# Without it: 60 GitHub API requests/hour (per IP) + heuristic commit counts.
# With it:    5,000 requests/hour + contribution-accurate commit counts.
# A *classic* token with NO scopes is enough for public data.
# Create one: https://github.com/settings/tokens → "Generate new token (classic)"
GITHUB_TOKEN=""

# ── Redis (OPTIONAL) ──────────────────────────────────────────────────────────
# If set, the cache + rate limiter use Redis instead of in-memory (needed only
# if you run more than one instance). Example: redis://default:pass@host:6379
REDIS_URL=""

# ── Public base URL ───────────────────────────────────────────────────────────
# Used for absolute share-card / OG image links and the sitemap.
# Set this to your deployed URL in production (e.g. https://gitpersona.up.railway.app).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
